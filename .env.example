# Copy to .env before running. Values below are a LOCAL TEST configuration only.

NODE_ENV=development
PORT=3000
# Base URL for download links. Never derive it from Host / X-Forwarded-Host.
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated API keys in the form <key>:<ownerId>. Required: the service refuses to start without keys.
# Generate a real key with: openssl rand -hex 32
# Never commit .env; this file is only a template.
API_KEYS=change-me:local-owner

# Resources (schemas, fonts, dictionaries). No data directory: PDFs are never stored.
RESOURCE_DIR=./resources

# In-memory PDF cache: repeats within TTL reuse bytes without re-rendering.
CACHE_TTL_SECONDS=900
CACHE_MAX_BYTES=67108864
# Download link lifetime (never longer than the cache entry).
DOWNLOAD_TOKEN_TTL_SECONDS=900
# Per-owner fixed-window quota for POST /conversions (0 disables)
RATE_LIMIT_PER_MINUTE=300

# Limits (product limits, not XSD limits)
MAX_BODY_BYTES=10485760
MAX_DECODED_BYTES=31457280
MAX_XML_ELEMENTS=100000
MAX_XML_DEPTH=64
MAX_XML_VALUE_CHARS=100000
MAX_GOODS_ROWS=1000
MAX_PDF_PAGES=100
MAX_PDF_BYTES=52428800

# Runtime budget
CONVERSION_TIMEOUT_MS=30000
XSD_TIMEOUT_MS=10000
RENDER_TIMEOUT_MS=20000
MAX_CONCURRENT_RENDERS=2
RENDER_QUEUE_LIMIT=10

# Swagger is public in development, disabled in production unless DOCS_ENABLED=true
DOCS_ENABLED=true

# Draft Saby-style layout for UPD СЧФДОП/ДОП (off by default)
UPD_SABY_LAYOUT=false

# Test-only: fill the paper blanks that the official XML formats do not carry
# (TORG-2: temperature, marking, weighing, sampling, manufacturer, station;
# UPD: receipt date/person). Never enable for real documents.
DEMO_FILL_BLANKS=false

# Playwright browser location (local dev only; the Docker image uses /ms-playwright)
PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers

# Optional external FNS visualization renderer (TORG-2).
# The JAR/templates are operator-supplied and are not part of this repository.
VISLIB_ENABLED=false
VISLIB_JAR=
VISLIB_TEMPLATES_DIR=
VISLIB_JAVA_PATH=java
VISLIB_TIMEOUT_MS=30000
