<?xml version="1.0" encoding="UTF-8"?>
<sch:schema xmlns:sch="http://purl.oclc.org/dsdl/schematron">
    <sch:ns uri="urn://x-artefacts/EMCHD_1" prefix="em"/>
    <sch:let name="КНД_1110415" value="1110415"/>
    <sch:let name="ПрЭлФорм_1" value="boolean(number(substring(em:Доверенность/@ПрЭлФорм, 1, 1)))"/>
    <sch:let name="ПрЭлФорм_2_ЕСИА" value="boolean(number(substring(em:Доверенность/@ПрЭлФорм, 2, 1)))"/>
    <sch:let name="ПрЭлФорм_3_Нотариус" value="boolean(number(substring(em:Доверенность/@ПрЭлФорм, 3, 1)))"/>
    <sch:let name="ПрЭлФорм_4_Налоговая" value="boolean(number(substring(em:Доверенность/@ПрЭлФорм, 4, 1)))"/>
    <sch:let name="ПрЭлФорм_5" value="boolean(number(substring(em:Доверенность/@ПрЭлФорм, 5, 1)))"/>
    <sch:let name="ПрЭлФорм_6" value="boolean(number(substring(em:Доверенность/@ПрЭлФорм, 6, 1)))"/>
    <sch:let name="ПрЭлФорм_7" value="boolean(number(substring(em:Доверенность/@ПрЭлФорм, 7, 1)))"/>
    <sch:let name="ПрЭлФорм_8" value="boolean(number(substring(em:Доверенность/@ПрЭлФорм, 8, 1)))"/>

    <sch:let name="ТипДоверит.1.Юридическое_лицо" value="1"/>
    <sch:let name="ТипДоверит.2.Иностранное_юридическое_лицо" value="2"/>
    <sch:let name="ТипДоверит.3.Индивидуальный_предприниматель" value="3"/>
    <sch:let name="ТипДоверит.4.Физическое_лицо" value="4"/>

    <sch:let name="ТипПред.1.Юридическое_лицо" value="1"/>
    <sch:let name="ТипПред.2.Индивидуальный_предприниматель" value="2"/>
    <sch:let name="ТипПред.3.Физическое_лицо" value="3"/>
    <sch:let name="ТипПред.4.Обособленное_подразделение_юридического_лица" value="4"/>
    <sch:let name="ТипПред.5.Аккредитованное_представительство_иностранного_юридического_лица" value="5"/>

    <sch:let name="ТипПерПолн.1.Юридическое_лицо" value="1"/>
    <sch:let name="ТипПерПолн.2.Индивидуальный_предприниматель" value="2"/>
    <sch:let name="ТипПерПолн.3.Физическое_лицо" value="3"/>
    <sch:let name="ТипПерПолн.4.Обособленное_подразделение_юридического_лица" value="4"/>
    <sch:let name="ТипПерПолн.5.Аккредитованное_представительство_иностранного_юридического_лица" value="5"/>

    <sch:let name="ПрСовмПолн.1.Индивидуальные" value="1"/>
    <sch:let name="ПрСовмПолн.2.Совместные" value="2"/>

    <sch:pattern id="Доверенность">
        <sch:title>
            Сведения о доверенности
        </sch:title>
        <sch:rule context="em:Доверенность">
            <sch:report test="$ПрЭлФорм_1">
                В данный момент система не поддерживает работу с атрибутом Доверенность/@ПрЭлФорм,
                равным '<sch:value-of select="@ПрЭлФорм"/>'
            </sch:report>
            <sch:report test="$ПрЭлФорм_2_ЕСИА">
                В данный момент система не поддерживает работу с атрибутом Доверенность/@ПрЭлФорм,
                равным '<sch:value-of select="@ПрЭлФорм"/>'
            </sch:report>
            <sch:report test="$ПрЭлФорм_5">
                В данный момент система не поддерживает работу с атрибутом Доверенность/@ПрЭлФорм,
                равным '<sch:value-of select="@ПрЭлФорм"/>'
            </sch:report>
            <sch:report test="$ПрЭлФорм_6">
                В данный момент система не поддерживает работу с атрибутом Доверенность/@ПрЭлФорм,
                равным '<sch:value-of select="@ПрЭлФорм"/>'
            </sch:report>
            <sch:report test="$ПрЭлФорм_7">
                В данный момент система не поддерживает работу с атрибутом Доверенность/@ПрЭлФорм,
                равным '<sch:value-of select="@ПрЭлФорм"/>'
            </sch:report>
            <sch:report test="$ПрЭлФорм_8">
                В данный момент система не поддерживает работу с атрибутом Доверенность/@ПрЭлФорм,
                равным '<sch:value-of select="@ПрЭлФорм"/>'
            </sch:report>
            <sch:assert test="matches(
                    @ИдФайл,
                    string-join(
                        (
                            '^ON_EMCHD',
                            '([2][0-9]{3})(0?[0][1-9]|[1][0-2])(0?[0][1-9]|(3?[3][0-1]|[1-2][0-9]))',
                            '[\da-fA-F]{8}-[\da-fA-F]{4}-[\da-fA-F]{4}-[\da-fA-F]{4}-[\da-fA-F]{12}$'
                        ),
                        '_'
                    )
                )">
                Атрибут Доверенность/@ИдФайл не соответствует требуемому формату
                (ON_EMCHD_${Дата_формирования_файла_в_формате_GGGGMMDD}_${Номер_файла_в_формате_GUID})
            </sch:assert>
            <sch:report test="not($ПрЭлФорм_2_ЕСИА) and @OID">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут Доверенность/@OID
            </sch:report>
            <sch:report test="$ПрЭлФорм_4_Налоговая and not(@ИдФайлНО)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут Доверенность/@ИдФайлНО
            </sch:report>
            <sch:report test="not($ПрЭлФорм_4_Налоговая) and @ИдФайлНО">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут Доверенность/@ИдФайлНО
            </sch:report>
            <sch:let name="R_T" value="'ON_DOVEL'"/>
            <sch:let name="КодНО" value="em:Документ/em:Довер/em:СвДов/@КодНО || em:Документ/em:Передов/em:СвПереДовер/@КодНО"/>
            <sch:let name="A_K" value="concat($КодНО, '_', $КодНО)"/>
            <sch:let name="ИННЮЛ" value="em:Документ/em:Довер/em:СвДоверит/em:Доверит/em:РосОргДовер/em:СвРосОрг/@ИННЮЛ || em:Документ/em:Передов/em:СвПередПолн/em:ПередПолн/em:РосОргПерПолн/em:СвРосОрг/@ИННЮЛ || em:Документ/em:Передов/em:СвПередПолн/em:ПередПолн/em:ФилПерПолн/em:СвФил/@ИННЮЛ"/>
            <sch:let name="КППЮЛ_1_2" value="substring(string(em:Документ/em:Довер/em:СвДоверит/em:Доверит/em:РосОргДовер/em:СвРосОрг/@КПП || em:Документ/em:Передов/em:СвПередПолн/em:ПередПолн/em:РосОргПерПолн/em:СвРосОрг/@КПП || em:Документ/em:Передов/em:СвПередПолн/em:ПередПолн/em:ФилПерПолн/em:СвФил/@КПП), 1, 2)"/>
            <sch:let name="ИННФЛ" value="em:Документ/em:Передов/em:СвПередПолн/em:ПередПолн/em:ФЛПерПолн/@ИННФЛ"/>
            <sch:let name="ИННИП" value="em:Документ/em:Довер/em:СвДоверит/em:Доверит/em:ИПДовер/@ИННФЛ || em:Документ/em:Передов/em:СвПередПолн/em:ПередПолн/em:ИППерПолн/@ИННФЛ"/>
            <sch:let name="O" value="concat($ИННЮЛ, $КППЮЛ_1_2, $ИННФЛ, $ИННИП)"/>
            <sch:let name="GGGGMMDD" value="substring(@ИдФайлНО, 33, 8)"/>
            <sch:let name="N" value="substring(@ИдФайлНО, 42, 36)"/>
            <sch:report test="$ПрЭлФорм_4_Налоговая and not(
                matches(@ИдФайлНО, concat($R_T, '_', $A_K, '_', $O, '_',$GGGGMMDD, '_', $N, '$'))
                and matches($O, '^\d{12}$')
                and matches($GGGGMMDD, '^([2][0-9]{3})(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])$')
                and upper-case($N) = (upper-case(em:Документ/em:Довер/em:СвДов/@НомДовер) || upper-case(em:Документ/em:Передов/em:СвПереДовер/@НомДовер)))">
                ИдФайлНО не соответствует требуемому формату или содержит ошибки в значении
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="Документ">
        <sch:title>
            Состав и структура документа
        </sch:title>
        <sch:rule context="em:Документ">
            <sch:report test="not($ПрЭлФорм_4_Налоговая) and @КНД">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут Документ/@КНД
            </sch:report>
            <sch:report test="$ПрЭлФорм_4_Налоговая and not(@КНД=$КНД_1110415)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                атрибут Доверенность/@КНД должен принимать значение, равное '<sch:value-of select="$КНД_1110415"/>'
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="Довер">
        <sch:title>
            Доверенность
        </sch:title>
        <sch:rule context="em:Довер">
            <sch:report test="count(em:СвДоверит)>1">
                В данный момент система не поддерживает работу с несколькими тегами Довер/СвДоверит
            </sch:report>
            <sch:report test="em:СвПолн/@ПрСовмПолн=$ПрСовмПолн.2.Совместные and count(em:СвУпПред)=1">
                При значении атрибута Довер/СвПолн/@ПрСовмПолн,
                равном '<sch:value-of select="$ПрСовмПолн.2.Совместные"/>',
                должно присутствовать больше одного тега Довер/СвУпПред
            </sch:report>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(em:СвНотУд)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать тег Довер/СвНотУд
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and em:СвНотУд">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать тег Довер/СвНотУд
            </sch:report>
        </sch:rule>
        <sch:rule context="em:Довер/em:СвДов">
            <sch:extends rule="СвДовТип"/>
        </sch:rule>
        <sch:rule context="em:Довер/em:СвДоверит">
            <sch:report test="@ТипДоверит=$ТипДоверит.2.Иностранное_юридическое_лицо">
                В данный момент система не поддерживает работу с атрибутом
                Довер/СвДоверит/@ТипДоверит,
                равным '<sch:value-of select="$ТипДоверит.2.Иностранное_юридическое_лицо"/>'
            </sch:report>
            <sch:report test="@ТипДоверит=$ТипДоверит.4.Физическое_лицо">
                В данный момент система не поддерживает работу с атрибутом
                Довер/СвДоверит/@ТипДоверит,
                равным '<sch:value-of select="$ТипДоверит.4.Физическое_лицо"/>'
            </sch:report>
        </sch:rule>
        <sch:rule context="em:Довер/em:СвУпПред">
            <sch:extends rule="СвУпПредТип"/>
        </sch:rule>
        <sch:rule context="em:Довер/em:СвПолн">
            <sch:extends rule="СвПолнТип"/>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="Доверит">
        <sch:title>
            Сведения о доверителе
        </sch:title>
        <sch:rule context="em:Доверит">
            <sch:report test="../@ТипДоверит=$ТипДоверит.1.Юридическое_лицо and not(em:РосОргДовер)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипДоверит,
                равном '<sch:value-of select="$ТипДоверит.1.Юридическое_лицо"/>',
                должен присутствовать тег Доверит/РосОргДовер
            </sch:report>
            <sch:report test="../@ТипДоверит=$ТипДоверит.1.Юридическое_лицо and exists(* except em:РосОргДовер)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипДоверит,
                равном '<sch:value-of select="$ТипДоверит.1.Юридическое_лицо"/>',
                должен присутствовать только тег Доверит/РосОргДовер
            </sch:report>
            <sch:report test="../@ТипДоверит=$ТипДоверит.3.Индивидуальный_предприниматель and not(em:ИПДовер)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипДоверит,
                равном '<sch:value-of select="$ТипДоверит.3.Индивидуальный_предприниматель"/>',
                должен присутствовать тег Доверит/ИПДовер
            </sch:report>
            <sch:report test="../@ТипДоверит=$ТипДоверит.3.Индивидуальный_предприниматель and exists(* except em:ИПДовер)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипДоверит,
                равном '<sch:value-of select="$ТипДоверит.3.Индивидуальный_предприниматель"/>',
                должен присутствовать только тег Доверит/ИПДовер
            </sch:report>
        </sch:rule>
        <sch:rule context="em:Доверит/em:РосОргДовер">
            <sch:extends rule="РосОргДоверТип"/>
        </sch:rule>
        <sch:rule context="em:Доверит/em:ИПДовер">
            <sch:extends rule="СведИПТип"/>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(@СтУчНД)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут Доверит/ИПДовер/@СтУчНД
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and @СтУчНД">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут Доверит/ИПДовер/@СтУчНД
            </sch:report>
            <sch:assert test="not(em:ДокПдтв)">
                Тег Доверит/ИПДовер не должен содержать тег ДокПдтв
            </sch:assert>
        </sch:rule>
        <sch:rule context="em:Доверит/em:ИПДовер/em:СведФЛ">
            <sch:extends rule="СведФЛТип"/>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="Передов">
        <sch:title>
            Передоверие
        </sch:title>
        <sch:rule context="em:Передов">
            <sch:let name="ПрНалПередов.0.Передоверие_от_первоначальной_доверенности" value="0"/>
            <sch:let name="ПрНалПередов.1.Передоверие_от_доверенности_передоверия" value="1"/>
            <sch:report test="@ПрНалПередов=$ПрНалПередов.0.Передоверие_от_первоначальной_доверенности and em:СвПередов">
                При значении атрибута
                Передов/@ПрНалПередов, равном '<sch:value-of select="$ПрНалПередов.0.Передоверие_от_первоначальной_доверенности"/>',
                должен отсутствовать тег Передов/СвПередов
            </sch:report>
            <sch:report test="@ПрНалПередов=$ПрНалПередов.1.Передоверие_от_доверенности_передоверия and not(em:СвПередов)">
                При значении атрибута
                Передов/@ПрНалПередов, равном '<sch:value-of select="$ПрНалПередов.1.Передоверие_от_доверенности_передоверия"/>',
                должен присутствовать тег Передов/СвПередов
            </sch:report>
            <sch:report test="count(em:СвПередПолн)>1">
                В данный момент система не поддерживает работу с несколькими тегами Передов/СвПередПолн
            </sch:report>
            <sch:report test="em:СвПолн/@ПрСовмПолн=$ПрСовмПолн.2.Совместные and count(em:СвПолучПолн)=1">
                При значении атрибута
                Передов/СвПолн/@ПрСовмПолн, равном '<sch:value-of select="$ПрСовмПолн.2.Совместные"/>',
                должно присутствовать больше одного тега Передов/СвПолучПолн
            </sch:report>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(em:СвНотУд)">
                При значении атрибута
                Доверенность/@ПрЭлФорм, равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать тег Передов/СвНотУд
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and em:СвНотУд">
                При значении атрибута
                Доверенность/@ПрЭлФорм, равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать тег Передов/СвНотУд
            </sch:report>
        </sch:rule>
        <sch:rule context="em:Передов/em:СвПервДовер">
            <sch:extends rule="СвПервДоверТип"/>
            <sch:assert test="@ПрДовер=$ПрДовер.1.Первоначальная_доверенность">
                Тег Передов/СвПервДовер должен содержать атрибут
                @ПрДовер, равный '<sch:value-of select="$ПрДовер.1.Первоначальная_доверенность"/>'
            </sch:assert>
            <sch:assert test="@ВнНомДоверПерв">
                Тег Передов/СвПервДовер должен содержать атрибут @ВнНомДоверПерв
            </sch:assert>
            <sch:assert test="not(@ВнНомДоверN)">
                Тег Передов/СвПервДовер не должен содержать атрибут @ВнНомДоверN
            </sch:assert>
            <sch:assert test="@НомДоверПерв">
                Тег Передов/СвПервДовер должен содержать атрибут @НомДоверПерв
            </sch:assert>
            <sch:assert test="not(@НомДоверN)">
                Тег Передов/СвПервДовер не должен содержать атрибут @НомДоверN
            </sch:assert>
            <sch:assert test="not(@НомРНДN)">
                Тег Передов/СвПервДовер не должен содержать атрибут @НомРНДN
            </sch:assert>
            <sch:assert test="em:СвДоверПерв">
                Тег Передов/СвПервДовер должен содержать вложенный тег СвДоверПерв
            </sch:assert>
            <sch:assert test="count(em:СвДоверПерв)=1">
                В данный момент система не поддерживает работу с несколькими тегами Передов/СвПервДовер/СвДоверПерв
            </sch:assert>
        </sch:rule>
        <sch:rule context="em:Передов/em:СвПередов">
            <sch:extends rule="СвПервДоверТип"/>
            <sch:assert test="@ПрДовер=$ПрДовер.2.Доверенность_выданная_в_порядке_передоверия">
                Тег Передов/СвПередов должен содержать атрибут
                @ПрДовер, равный '<sch:value-of select="$ПрДовер.2.Доверенность_выданная_в_порядке_передоверия"/>'
            </sch:assert>
            <sch:assert test="not(@ВнНомДоверПерв)">
                Тег Передов/СвПередов не должен содержать атрибут @ВнНомДоверПерв
            </sch:assert>
            <sch:assert test="@ВнНомДоверN">
                Тег Передов/СвПередов должен содержать атрибут @ВнНомДоверN
            </sch:assert>
            <sch:assert test="not(@НомДоверПерв)">
                Тег Передов/СвПередов не должен содержать атрибут @НомДоверПерв
            </sch:assert>
            <sch:assert test="@НомДоверN">
                Тег Передов/СвПередов должен содержать атрибут @НомДоверN
            </sch:assert>
            <sch:assert test="not(@НомРНДПерв)">
                Тег Передов/СвПередов не должен содержать атрибут @НомРНДПерв
            </sch:assert>
            <sch:assert test="not(em:СвДоверПерв)">
                Тег Передов/СвПередов не должен содержать вложенный тег СвДоверПерв
            </sch:assert>
        </sch:rule>
        <sch:rule context="em:Передов/em:СвПереДовер">
            <sch:extends rule="СвДовТип"/>
        </sch:rule>
        <sch:rule context="em:Передов/em:СвПередПолн">
            <sch:report test="@ТипПерПолн=$ТипПерПолн.5.Аккредитованное_представительство_иностранного_юридического_лица">
                В данный момент система не поддерживает работу с атрибутом Передов/СвПередПолн/@ТипПерПолн,
                равным '<sch:value-of select="$ТипПерПолн.5.Аккредитованное_представительство_иностранного_юридического_лица"/>'
            </sch:report>
        </sch:rule>
        <sch:rule context="em:Передов/em:СвПолучПолн">
            <sch:extends rule="СвУпПредТип"/>
            <sch:report test="@ТипПред=$ТипПред.1.Юридическое_лицо">
                В данный момент система не поддерживает работу с атрибутом Передов/СвПолучПолн/@ТипПред,
                равным '<sch:value-of select="$ТипПред.1.Юридическое_лицо"/>'
            </sch:report>
            <sch:report test="@ТипПред=$ТипПред.4.Обособленное_подразделение_юридического_лица">
                В данный момент система не поддерживает работу с атрибутом
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ТипПред,
                равным '<sch:value-of select="$ТипПред.4.Обособленное_подразделение_юридического_лица"/>'
            </sch:report>
        </sch:rule>
        <sch:rule context="em:Передов/em:СвПолн">
            <sch:extends rule="СвПолнТип"/>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="ПередПолн">
        <sch:title>
            Сведения о лице, передавшем полномочия
        </sch:title>
        <sch:rule context="em:ПередПолн">
            <sch:report test="../@ТипПерПолн=$ТипПерПолн.1.Юридическое_лицо and not(em:РосОргПерПолн)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПерПолн,
                равном '<sch:value-of select="$ТипПерПолн.1.Юридическое_лицо"/>',
                должен присутствовать тег ПередПолн/РосОргПерПолн
            </sch:report>
            <sch:report test="../@ТипПерПолн=$ТипПерПолн.1.Юридическое_лицо and exists(* except em:РосОргПерПолн)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПерПолн,
                равном '<sch:value-of select="$ТипПерПолн.1.Юридическое_лицо"/>',
                должен присутствовать только тег ПередПолн/РосОргПерПолн
            </sch:report>
            <sch:report test="../@ТипПерПолн=$ТипПерПолн.2.Индивидуальный_предприниматель and not(em:ИППерПолн)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПерПолн,
                равном '<sch:value-of select="$ТипПерПолн.2.Индивидуальный_предприниматель"/>',
                должен присутствовать тег ПередПолн/ИППерПолн
            </sch:report>
            <sch:report test="../@ТипПерПолн=$ТипПерПолн.2.Индивидуальный_предприниматель and exists(* except em:ИППерПолн)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПерПолн,
                равном '<sch:value-of select="$ТипПерПолн.2.Индивидуальный_предприниматель"/>',
                должен присутствовать только тег ПередПолн/ИППерПолн
            </sch:report>
            <sch:report test="../@ТипПерПолн=$ТипПерПолн.3.Физическое_лицо and not(em:ФЛПерПолн)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПерПолн,
                равном '<sch:value-of select="$ТипПерПолн.3.Физическое_лицо"/>',
                должен присутствовать тег ПередПолн/ФЛПерПолн
            </sch:report>
            <sch:report test="../@ТипПерПолн=$ТипПерПолн.3.Физическое_лицо and exists(* except em:ФЛПерПолн)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПерПолн,
                равном '<sch:value-of select="$ТипПерПолн.3.Физическое_лицо"/>',
                должен присутствовать только тег ПередПолн/ФЛПерПолн
            </sch:report>
            <sch:report test="../@ТипПерПолн=$ТипПерПолн.4.Обособленное_подразделение_юридического_лица and not($ПрЭлФорм_3_Нотариус)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПерПолн,
                равном '<sch:value-of select="$ТипПерПолн.4.Обособленное_подразделение_юридического_лица"/>',
                должно быть значение атрибута @ПрЭлФорм='00100000' или @ПрЭлФорм='00110000'
            </sch:report>
            <sch:report test="../@ТипПерПолн=$ТипПерПолн.4.Обособленное_подразделение_юридического_лица and not(em:ФилПерПолн)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПерПолн,
                равном '<sch:value-of select="$ТипПерПолн.4.Обособленное_подразделение_юридического_лица"/>',
                должен присутствовать тег ПередПолн/ФилПерПолн
            </sch:report>
            <sch:report test="../@ТипПерПолн=$ТипПерПолн.4.Обособленное_подразделение_юридического_лица and exists(* except em:ФилПерПолн)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПерПолн,
                равном '<sch:value-of select="$ТипПерПолн.4.Обособленное_подразделение_юридического_лица"/>',
                должен присутствовать только тег ПередПолн/ФилПерПолн
            </sch:report>
        </sch:rule>
        <sch:rule context="em:ПередПолн/em:РосОргПерПолн">
            <sch:extends rule="РосОргДоверТип"/>
        </sch:rule>
        <sch:rule context="em:ПередПолн/em:ИППерПолн">
            <sch:extends rule="СведИПТип"/>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(@СтУчНД)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут ПередПолн/ИППерПолн/@СтУчНД
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and @СтУчНД">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут ПередПолн/ИППерПолн/@СтУчНД
            </sch:report>
            <sch:assert test="not(em:ДокПдтв)">
                Тег ПередПолн/ИППерПолн не должен содержать тег ДокПдтв
            </sch:assert>
        </sch:rule>
        <sch:rule context="em:ПередПолн/em:ИППерПолн/em:СведФЛ">
            <sch:extends rule="СведФЛТип"/>
        </sch:rule>
        <sch:rule context="em:ПередПолн/em:ФЛПерПолн">
            <sch:let name="ПрНалРук.0.Выключен" value="0"/>
            <sch:let name="ПрНалРук.1.Включен" value="1"/>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(@СтУчНД)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут ПередПолн/ФЛПерПолн/@СтУчНД
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and @СтУчНД">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут ПередПолн/ФЛПерПолн/@СтУчНД
            </sch:report>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(@ПрНалРук)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут ПередПолн/ФЛПерПолн/@ПрНалРук
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and @ПрНалРук">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут ПередПолн/ФЛПерПолн/@ПрНалРук
            </sch:report>
            <sch:report test="@ПрНалРук=$ПрНалРук.1.Включен">
                В данный момент система не поддерживает работу с атрибутом ПередПолн/ФЛПерПолн/@ПрНалРук,
                равным '<sch:value-of select="$ПрНалРук.1.Включен"/>'
            </sch:report>
            <sch:report test="em:СведРукоп">
                В данный момент система не поддерживает работу с тегом ПередПолн/ФЛПерПолн/СведРукоп
            </sch:report>
        </sch:rule>
        <sch:rule context="em:ПередПолн/em:ФЛПерПолн/em:СведФЛ">
            <sch:extends rule="СведФЛТип"/>
        </sch:rule>
        <sch:rule context="em:ПередПолн/em:ФилПерПолн/em:СвФил">
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(@СтУчНД)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут ПередПолн/ФилПерПолн/СвФил/@СтУчНД
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and @СтУчНД">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут ПередПолн/ФилПерПолн/СвФил/@СтУчНД
            </sch:report>
            <sch:assert test="@ИННЮЛ">
                Тег ПередПолн/ФилПерПолн/СвФил должен содержать атрибут @ИННЮЛ
            </sch:assert>
            <sch:assert test="not(em:ДокПдтв)">
                Тег ПередПолн/ФилПерПолн/СвФил не должен содержать тег ДокПдтв
            </sch:assert>
            <sch:assert test="em:АдрРег">
                Тег ПередПолн/ФилПерПолн/СвФил должен содержать тег АдрРег
            </sch:assert>
        </sch:rule>
        <sch:rule context="em:ПередПолн/em:ФилПерПолн/em:СвРукФил">
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(@СтУчНД)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут ПередПолн/ФилПерПолн/СвРукФил/@СтУчНД
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and @СтУчНД">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут ПередПолн/ФилПерПолн/СвРукФил/@СтУчНД
            </sch:report>
            <sch:assert test="@СНИЛС">
                Тег ПередПолн/ФилПерПолн/СвРукФил должен содержать атрибут @СНИЛС
            </sch:assert>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(em:ДокПдтв)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать тег ПередПолн/ФилПерПолн/СвРукФил/ДокПдтв
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and em:ДокПдтв">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать тег ПередПолн/ФилПерПолн/СвРукФил/ДокПдтв
            </sch:report>
        </sch:rule>
        <sch:rule context="em:ПередПолн/em:ФилПерПолн/em:СвРукФил/em:СведФЛ">
            <sch:extends rule="СведФЛТип"/>
        </sch:rule>
    </sch:pattern>

    <sch:pattern>
        <sch:title>
            Сведения о юридическом лице
        </sch:title>
        <sch:rule abstract="true" id="РосОргДоверТип">
            <sch:report test="sum(@ЕИОУК|@ЕИОФЛ|@ЕИОИП)=0">
                Один из атрибутов
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/(@ЕИОУК|@ЕИОФЛ|@ЕИОИП)
                должен быть равен '1'
            </sch:report>
            <sch:report test="sum(@ЕИОУК|@ЕИОФЛ|@ЕИОИП)>1">
                В данный момент система не поддерживает работу с несколькими атрибутами
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/(@ЕИОУК|@ЕИОФЛ|@ЕИОИП),
                равными '1'
            </sch:report>
            <sch:report test="count(em:ЛицоБезДов)>1">
                В данный момент система не поддерживает работу с несколькими тегами
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/ЛицоБезДов
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="СвРосОрг">
        <sch:title>
            Сведения о юридическом лице или филиале (обособленном подразделении) юридического лица
        </sch:title>
        <sch:rule context="em:СвРосОрг">
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(@СтУчНД)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут <sch:value-of select="../local-name()"/>/СвРосОрг/@СтУчНД
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and @СтУчНД">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут <sch:value-of select="../local-name()"/>/СвРосОрг/@СтУчНД
            </sch:report>
            <sch:assert test="@ИННЮЛ">
                Тег <sch:value-of select="../local-name()"/>/СвРосОрг
                должен содержать атрибут @ИННЮЛ
            </sch:assert>
            <sch:assert test="@ОГРН">
                Тег <sch:value-of select="../local-name()"/>/СвРосОрг
                должен содержать атрибут @ОГРН
            </sch:assert>
            <sch:assert test="not(em:ДокПдтв)">
                Тег <sch:value-of select="../local-name()"/>/СвРосОрг
                не должен содержать тег ДокПдтв
            </sch:assert>
            <sch:assert test="em:АдрРег">
                Тег <sch:value-of select="../local-name()"/>/СвРосОрг
                должен содержать тег АдрРег
            </sch:assert>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="ЛицоБезДов">
        <sch:title>
            Сведения о лице (лицах), действующем (действующих) от имени юридического лица без доверенности
        </sch:title>
        <sch:rule context="em:ЛицоБезДов">
            <sch:extends rule="ЛицоБезДовТип"/>
        </sch:rule>
    </sch:pattern>

    <sch:pattern>
        <sch:title>
            Сведения о лице (лицах), в том числе законном представителе, действующем (действующих) без доверенности
        </sch:title>
        <sch:rule abstract="true" id="ЛицоБезДовТип">
            <sch:let name="ПолнЮЛ.1.Индивидуальные" value="1"/>
            <sch:let name="ПолнЮЛ.2.Совместные" value="2"/>
            <sch:let name="ЕИОУК.0.Выключен" value="0"/>
            <sch:let name="ЕИОУК.1.Включен" value="1"/>
            <sch:let name="ЕИОФЛ.0.Выключен" value="0"/>
            <sch:let name="ЕИОФЛ.1.Включен" value="1"/>
            <sch:let name="ЕИОИП.0.Выключен" value="0"/>
            <sch:let name="ЕИОИП.1.Включен" value="1"/>
            <sch:report test="@ПолнЮЛ=$ПолнЮЛ.2.Совместные">
                В данный момент система не поддерживает работу с атрибутом
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ПолнЮЛ,
                равным '<sch:value-of select="$ПолнЮЛ.2.Совместные"/>'
            </sch:report>
            <sch:report test="../@ЕИОУК=$ЕИОУК.1.Включен and not(em:СВЮЛ)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ЕИОУК,
                равном '<sch:value-of select="$ЕИОУК.1.Включен"/>', должен присутствовать тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/СВЮЛ
            </sch:report>
            <sch:report test="../@ЕИОУК=$ЕИОУК.1.Включен and exists(* except em:СВЮЛ)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ЕИОУК,
                равном '<sch:value-of select="$ЕИОУК.1.Включен"/>', должен присутствовать только тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/СВЮЛ
            </sch:report>
            <sch:report test="../@ЕИОФЛ=$ЕИОФЛ.1.Включен and not(em:СвФЛ)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ЕИОФЛ,
                равном '<sch:value-of select="$ЕИОФЛ.1.Включен"/>', должен присутствовать тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/СвФЛ
            </sch:report>
            <sch:report test="../@ЕИОФЛ=$ЕИОФЛ.1.Включен and exists(* except em:СвФЛ)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ЕИОФЛ,
                равном '<sch:value-of select="$ЕИОФЛ.1.Включен"/>', должен присутствовать только тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/СвФЛ
            </sch:report>
            <sch:report test="../@ЕИОИП=$ЕИОИП.1.Включен and not(em:СвИП)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ЕИОИП,
                равном '<sch:value-of select="$ЕИОИП.1.Включен"/>', должен присутствовать тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/СвИП
            </sch:report>
            <sch:report test="../@ЕИОИП=$ЕИОИП.1.Включен and exists(* except em:СвИП)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ЕИОИП,
                равном '<sch:value-of select="$ЕИОИП.1.Включен"/>', должен присутствовать только тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/СвИП
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="СВЮЛ">
        <sch:title>
            Сведения о единоличном исполнительном органе – управляющей компании
        </sch:title>
        <sch:rule context="em:СВЮЛ">
            <sch:report test="count(em:СвФЛ)>1">
                В данный момент система не поддерживает работу с несколькими тегами СВЮЛ/СвФЛ
            </sch:report>
        </sch:rule>
        <sch:rule context="em:СВЮЛ/em:СвЮЛЕИО">
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(@СтУчНД)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут СВЮЛ/СвЮЛЕИО/@СтУчНД
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and @СтУчНД">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут СВЮЛ/СвЮЛЕИО/@СтУчНД
            </sch:report>
            <sch:assert test="@ИННЮЛ">
                Тег СВЮЛ/СвЮЛЕИО должен содержать атрибут @ИННЮЛ
            </sch:assert>
            <sch:assert test="@ОГРН">
                Тег СВЮЛ/СвЮЛЕИО должен содержать атрибут @ОГРН
            </sch:assert>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(em:ДокПдтв)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать тег СВЮЛ/СвЮЛЕИО/ДокПдтв
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and em:ДокПдтв">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать тег СВЮЛ/СвЮЛЕИО/ДокПдтв
            </sch:report>
            <sch:assert test="em:АдрРег">
                Тег СВЮЛ/СвЮЛЕИО должен содержать тег АдрРег
            </sch:assert>
        </sch:rule>
        <sch:rule context="em:СВЮЛ/em:СвФЛ">
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(@СтУчНД)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут СВЮЛ/СвФЛ/@СтУчНД
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and @СтУчНД">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут СВЮЛ/СвФЛ/@СтУчНД
            </sch:report>
            <sch:assert test="@СНИЛС">
                Тег СВЮЛ/СвФЛ должен содержать атрибут @СНИЛС
            </sch:assert>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(em:ДокПдтв)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать тег СВЮЛ/СвФЛ/ДокПдтв
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and em:ДокПдтв">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать тег СВЮЛ/СвФЛ/ДокПдтв
            </sch:report>
        </sch:rule>
        <sch:rule context="em:СВЮЛ/em:СвФЛ/em:СведФЛ">
            <sch:extends rule="СведФЛТип"/>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="СвФЛ">
        <sch:title>
            Сведения о единоличном исполнительном органе - физическом лице
        </sch:title>
        <sch:rule context="em:СвФЛ">
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(@СтУчНД)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут СвФЛ/@СтУчНД
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and @СтУчНД">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут СвФЛ/@СтУчНД
            </sch:report>
            <sch:assert test="@СНИЛС">
                Тег СвФЛ должен содержать атрибут @СНИЛС
            </sch:assert>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(em:ДокПдтв)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать тег СвФЛ/ДокПдтв
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and em:ДокПдтв">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать тег СвФЛ/ДокПдтв
            </sch:report>
        </sch:rule>
        <sch:rule context="em:СвФЛ/em:СведФЛ">
            <sch:extends rule="СведФЛТип"/>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="СвИП">
        <sch:title>
            Сведения о единоличном исполнительном органе - физическом лице
        </sch:title>
        <sch:rule context="em:СвИП">
            <sch:extends rule="СведИПТип"/>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(@СтУчНД)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут СвИП/@СтУчНД
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and @СтУчНД">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут СвИП/@СтУчНД
            </sch:report>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(em:ДокПдтв)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать тег СвИП/ДокПдтв
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and em:ДокПдтв">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать тег СвИП/ДокПдтв
            </sch:report>
        </sch:rule>
        <sch:rule context="em:СвИП/em:СведФЛ">
            <sch:extends rule="СведФЛТип"/>
        </sch:rule>
    </sch:pattern>

    <sch:pattern>
        <sch:title>
            Сведения об индивидуальном предпринимателе
        </sch:title>
        <sch:rule abstract="true" id="СведИПТип">
            <sch:report test="not($ПрЭлФорм_2_ЕСИА) and @НаимИП">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>', должен отсутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@НаимИП
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern>
        <sch:title>
            Сведения о первоначальной доверенности (или доверенности, на основании которой осуществляется передоверие)
        </sch:title>
        <sch:rule abstract="true" id="СвПервДоверТип">
            <sch:let name="ПрДовер.1.Первоначальная_доверенность" value="1"/>
            <sch:let name="ПрДовер.2.Доверенность_выданная_в_порядке_передоверия" value="2"/>
            <sch:let name="ФормДовер.1.В_электронной_форме" value="1"/>
            <sch:let name="ФормДовер.2.На_бумажном_носителе" value="2"/>
            <sch:report test="@ФормДовер=$ФормДовер.2.На_бумажном_носителе">
                В данный момент система не поддерживает работу с атрибутом
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ФормДовер,
                равным '<sch:value-of select="$ФормДовер.2.На_бумажном_носителе"/>'
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="СвДоверПерв">
        <sch:title>
            Сведения о доверителе (доверителях) первоначальной доверенности
        </sch:title>
        <sch:rule context="em:СвДоверПерв">
            <sch:report test="@ТипДоверит=$ТипДоверит.2.Иностранное_юридическое_лицо">
                В данный момент система не поддерживает работу с атрибутом СвДоверПерв/@ТипДоверит,
                равным '<sch:value-of select="$ТипДоверит.2.Иностранное_юридическое_лицо"/>'
            </sch:report>
            <sch:report test="@ТипДоверит=$ТипДоверит.4.Физическое_лицо">
                В данный момент система не поддерживает работу с атрибутом СвДоверПерв/@ТипДоверит,
                равным '<sch:value-of select="$ТипДоверит.4.Физическое_лицо"/>'
            </sch:report>
        </sch:rule>
        <sch:rule context="em:СвДоверПерв/em:ДоверитПерв">
            <sch:report test="../@ТипДоверит=$ТипДоверит.1.Юридическое_лицо and not(em:РосОргДовер)">
                При значении атрибута СвДоверПерв/@ТипДоверит,
                равном '<sch:value-of select="$ТипДоверит.1.Юридическое_лицо"/>',
                должен присутствовать тег СвДоверПерв/ДоверитПерв/РосОргДовер
            </sch:report>
            <sch:report test="../@ТипДоверит=$ТипДоверит.1.Юридическое_лицо and exists(* except em:РосОргДовер)">
                При значении атрибута СвДоверПерв/@ТипДоверит,
                равном '<sch:value-of select="$ТипДоверит.1.Юридическое_лицо"/>',
                должен присутствовать только тег СвДоверПерв/ДоверитПерв/РосОргДовер
            </sch:report>
            <sch:report test="../@ТипДоверит=$ТипДоверит.3.Индивидуальный_предприниматель and not(em:ИПДовер)">
                При значении атрибута СвДоверПерв/@ТипДоверит,
                равном '<sch:value-of select="$ТипДоверит.3.Индивидуальный_предприниматель"/>',
                должен присутствовать тег СвДоверПерв/ДоверитПерв/ИПДовер
            </sch:report>
            <sch:report test="../@ТипДоверит=$ТипДоверит.3.Индивидуальный_предприниматель and exists(* except em:ИПДовер)">
                При значении атрибута СвДоверПерв/@ТипДоверит,
                равном '<sch:value-of select="$ТипДоверит.3.Индивидуальный_предприниматель"/>',
                должен присутствовать только тег СвДоверПерв/ДоверитПерв/ИПДовер
            </sch:report>
        </sch:rule>
        <sch:rule context="em:СвДоверПерв/em:ДоверитПерв/em:РосОргДовер">
            <sch:assert test="not(@СтУчНД)">
                Тег СвДоверПерв/ДоверитПерв/РосОргДовер не должен содержать атрибут @СтУчНД
            </sch:assert>
            <sch:assert test="@ИННЮЛ">
                Тег СвДоверПерв/ДоверитПерв/РосОргДовер должен содержать атрибут @ИННЮЛ
            </sch:assert>
            <sch:assert test="@ОГРН">
                Тег СвДоверПерв/ДоверитПерв/РосОргДовер должен содержать атрибут @ОГРН
            </sch:assert>
            <sch:assert test="not(em:ДокПдтв)">
                Тег СвДоверПерв/ДоверитПерв/РосОргДовер не должен содержать тег ДокПдтв
            </sch:assert>
            <sch:assert test="em:АдрРег">
                Тег СвДоверПерв/ДоверитПерв/РосОргДовер должен содержать тег АдрРег
            </sch:assert>
        </sch:rule>
        <sch:rule context="em:СвДоверПерв/em:ДоверитПерв/em:ИПДовер">
            <sch:extends rule="СведИПТип"/>
            <sch:assert test="not(@СтУчНД)">
                Тег СвДоверПерв/ДоверитПерв/ИПДовер не должен содержать атрибут @СтУчНД
            </sch:assert>
            <sch:assert test="not(em:ДокПдтв)">
                Тег СвДоверПерв/ДоверитПерв/ИПДовер не должен содержать тег ДокПдтв
            </sch:assert>
        </sch:rule>
        <sch:rule context="em:СвДоверПерв/em:ДоверитПерв/em:ИПДовер/em:СведФЛ">
            <sch:extends rule="СведФЛТип"/>
        </sch:rule>
    </sch:pattern>

    <sch:pattern>
        <sch:title>
            Сведения доверенности
        </sch:title>
        <sch:rule abstract="true" id="СвДовТип">
            <sch:let name="ВидДовер.1.С_возможностью_отзыва" value="1"/>
            <sch:let name="ВидДовер.2.Без_возможности_отзыва" value="2"/>
            <sch:let name="ПрПередов.1.Без_права_передоверия" value="1"/>
            <sch:let name="ПрПередов.2.Однократное_передоверие" value="2"/>
            <sch:let name="ПрПередов.3.С_правом_последующего_передоверия" value="3"/>
            <sch:report test="@ВидДовер=$ВидДовер.2.Без_возможности_отзыва">
                В данный момент система не поддерживает работу с атрибутом
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ВидДовер,
                равным '<sch:value-of select="$ВидДовер.2.Без_возможности_отзыва"/>'
            </sch:report>
            <sch:report test="@ПрПередов=$ПрПередов.1.Без_права_передоверия and ../em:СвПолн[@ПрУтрПолн]">
                При значении атрибута
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ПрПередов,
                равном '<sch:value-of select="$ПрПередов.1.Без_права_передоверия"/>',
                должен отсутствовать атрибут <sch:value-of select="../local-name()"/>/СвПолн/@ПрУтрПолн
            </sch:report>
            <sch:report test="@ПрПередов=$ПрПередов.2.Однократное_передоверие and not(../em:СвПолн[@ПрУтрПолн])">
                При значении атрибута
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ПрПередов,
                равном '<sch:value-of select="$ПрПередов.2.Однократное_передоверие"/>',
                должен присутствовать атрибут <sch:value-of select="../local-name()"/>/СвПолн/@ПрУтрПолн
            </sch:report>
            <sch:report test="@ПрПередов=$ПрПередов.3.С_правом_последующего_передоверия and not(../em:СвПолн[@ПрУтрПолн])">
                При значении атрибута
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ПрПередов,
                равном '<sch:value-of select="$ПрПередов.3.С_правом_последующего_передоверия"/>',
                должен присутствовать атрибут <sch:value-of select="../local-name()"/>/СвПолн/@ПрУтрПолн
            </sch:report>
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(@НомРНДДовер)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>', должен присутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@НомРНДДовер
            </sch:report>
            <sch:report test="not($ПрЭлФорм_3_Нотариус) and @НомРНДДовер">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>', должен отсутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@НомРНДДовер
            </sch:report>
            <sch:report test="not($ПрЭлФорм_2_ЕСИА) and @ДатаВнРегДовер">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>', должен отсутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ДатаВнРегДовер
            </sch:report>
            <sch:report test="not($ПрЭлФорм_4_Налоговая) and @КодНО">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>', должен отсутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@КодНО
            </sch:report>
            <sch:report test="$ПрЭлФорм_4_Налоговая and not(@КодНО)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>', должен присутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@КодНО
            </sch:report>
            <sch:report test="not($ПрЭлФорм_4_Налоговая) and em:КодНОДейст">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>', должен отсутствовать тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/КодНОДейст
            </sch:report>
            <sch:report test="em:Безотзыв">
                В данный момент система не поддерживает работу с тегом
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/Безотзыв
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern>
        <sch:title>
            Сведения о представителе (представителях)
        </sch:title>
        <sch:rule abstract="true" id="СвУпПредТип">
            <sch:report test="@ТипПред=$ТипПред.5.Аккредитованное_представительство_иностранного_юридического_лица">
                В данный момент система не поддерживает работу с атрибутом
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ТипПред,
                равным '<sch:value-of select="$ТипПред.5.Аккредитованное_представительство_иностранного_юридического_лица"/>'
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="Пред">
        <sch:title>
            Сведения о представителе
        </sch:title>
        <sch:let name="ТипПолн.1.Машиночитаемое_полномочие" value="1"/>
        <sch:rule context="em:Пред">
            <sch:report test="../@ТипПред=$ТипПред.1.Юридическое_лицо and not(em:СведОрг)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПред,
                равном '<sch:value-of select="$ТипПред.1.Юридическое_лицо"/>',
                должен присутствовать тег Пред/СведОрг
            </sch:report>
            <sch:report test="../@ТипПред=$ТипПред.1.Юридическое_лицо and exists(* except em:СведОрг)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПред,
                равном '<sch:value-of select="$ТипПред.1.Юридическое_лицо"/>',
                должен присутствовать только тег Пред/СведОрг
            </sch:report>
            <sch:report test="../@ТипПред=$ТипПред.2.Индивидуальный_предприниматель and not(em:СведИП)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПред,
                равном '<sch:value-of select="$ТипПред.2.Индивидуальный_предприниматель"/>',
                должен присутствовать тег Пред/СведИП
            </sch:report>
            <sch:report test="../@ТипПред=$ТипПред.2.Индивидуальный_предприниматель and exists(* except em:СведИП)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПред,
                равном '<sch:value-of select="$ТипПред.2.Индивидуальный_предприниматель"/>',
                должен присутствовать только тег Пред/СведИП
            </sch:report>
            <sch:report test="../@ТипПред=$ТипПред.3.Физическое_лицо and not(em:СведФизЛ)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПред,
                равном '<sch:value-of select="$ТипПред.3.Физическое_лицо"/>',
                должен присутствовать тег Пред/СведФизЛ
            </sch:report>
            <sch:report test="../@ТипПред=$ТипПред.3.Физическое_лицо and exists(* except em:СведФизЛ)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПред,
                равном '<sch:value-of select="$ТипПред.3.Физическое_лицо"/>',
                должен присутствовать только тег Пред/СведФизЛ
            </sch:report>
            <sch:report test="../@ТипПред=$ТипПред.4.Обособленное_подразделение_юридического_лица
                and not(em:СведФизЛ and em:СведФилиал)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПред,
                равном '<sch:value-of select="$ТипПред.4.Обособленное_подразделение_юридического_лица"/>',
                должны присутствовать теги Пред/СведФизЛ и Пред/СведФилиал
            </sch:report>
            <sch:report test="../@ТипПред=$ТипПред.4.Обособленное_подразделение_юридического_лица
                and * except (em:СведФизЛ, em:СведФилиал)">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПред,
                равном '<sch:value-of select="$ТипПред.4.Обособленное_подразделение_юридического_лица"/>',
                должны присутствовать только теги Пред/СведФизЛ и Пред/СведФилиал
            </sch:report>
            <sch:report test="../@ТипПред=$ТипПред.4.Обособленное_подразделение_юридического_лица
                and count(../../*[@ТипПред])>1">
                При значении атрибута <sch:value-of select="../local-name()"/>/@ТипПред,
                равном '<sch:value-of select="$ТипПред.4.Обособленное_подразделение_юридического_лица"/>',
                должен присутствовать только один тег <sch:value-of select="../local-name()"/>
            </sch:report>
            <sch:report test="../@ТипПред=$ТипПред.4.Обособленное_подразделение_юридического_лица
                and not($ПрЭлФорм_3_Нотариус)">
                В данный момент система не поддерживает работу с атрибутом @ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                при значении атрибута <sch:value-of select="../local-name()"/>/@ТипПред,
                равном '<sch:value-of select="$ТипПред.4.Обособленное_подразделение_юридического_лица"/>'
            </sch:report>
        </sch:rule>
        <sch:rule context="em:Пред/em:СведОрг">
            <sch:assert test="not(@СтУчНД)">
                Тег Пред/СведОрг не должен содержать атрибут @СтУчНД
            </sch:assert>
            <sch:assert test="@ИННЮЛ">
                Тег Пред/СведОрг должен содержать атрибут @ИННЮЛ
            </sch:assert>
            <sch:assert test="@ОГРН">
                Тег Пред/СведОрг должен содержать атрибут @ОГРН
            </sch:assert>
            <sch:assert test="not(em:ДокПдтв)">
                Тег Пред/СведОрг не должен содержать тег ДокПдтв
            </sch:assert>
            <sch:let name="innul" value="@ИННЮЛ"/>
            <sch:let name="kpp" value="@КПП"/>
            <sch:report test="../../following-sibling::*//em:Пред/em:СведОрг[@ИННЮЛ=$innul and @КПП=$kpp]">
                Значения атрибутов @ИННЮЛ и @КПП должны быть уникальными в рамках тегов Пред/СведОрг
            </sch:report>
        </sch:rule>
        <sch:rule context="em:Пред/em:СведИП">
            <sch:extends rule="СведИПТип"/>
            <sch:assert test="not(@СтУчНД)">
                Тег Пред/СведИП не должен содержать атрибут @СтУчНД
            </sch:assert>
            <sch:assert test="not(em:ДокПдтв)">
                Тег Пред/СведИП не должен содержать тег ДокПдтв
            </sch:assert>
            <sch:let name="ogrnip" value="@ОГРНИП"/>
            <sch:report test="../../following-sibling::*//em:Пред/em:СведИП[@ОГРНИП=$ogrnip]">
                Значение атрибута @ОГРНИП должно быть уникальным в рамках тегов Пред/СведИП
            </sch:report>
        </sch:rule>
        <sch:rule context="em:Пред/em:СведИП/em:СведФЛ">
            <sch:extends rule="СведФЛТип"/>
            <sch:assert test="@ДатаРожд">
                Тег Пред/СведИП/СведФЛ должен содержать атрибут @ДатаРожд
            </sch:assert>
            <sch:assert test="em:УдЛичнФЛ">
                Тег Пред/СведИП/СведФЛ должен содержать тег УдЛичнФЛ
            </sch:assert>
        </sch:rule>
        <sch:rule context="em:Пред/em:СведФизЛ">
            <sch:assert test="not(@СтУчНД)">
                Тег Пред/СведФизЛ не должен содержать атрибут @СтУчНД
            </sch:assert>
            <sch:assert test="@ИННФЛ">
                Тег Пред/СведФизЛ должен содержать атрибут @ИННФЛ
            </sch:assert>
            <sch:assert test="@СНИЛС">
                Тег Пред/СведФизЛ должен содержать атрибут @СНИЛС
            </sch:assert>
            <sch:assert test="not(em:ДокПдтв)">
                Тег Пред/СведФизЛ не должен содержать тег ДокПдтв
            </sch:assert>
            <sch:let name="innfl" value="@ИННФЛ"/>
            <sch:report test="../../following-sibling::*//em:Пред/em:СведФизЛ[@ИННФЛ=$innfl]">
                Значение атрибута @ИННФЛ должно быть уникальным в рамках тегов Пред/СведФизЛ
            </sch:report>
        </sch:rule>
        <sch:rule context="em:Пред/em:СведФизЛ/em:СведФЛ">
            <sch:extends rule="СведФЛТип"/>
            <sch:assert test="@ДатаРожд">
                Тег Пред/СведФизЛ/СведФЛ должен содержать атрибут @ДатаРожд
            </sch:assert>
            <sch:assert test="em:УдЛичнФЛ">
                Тег Пред/СведФизЛ/СведФЛ должен содержать тег УдЛичнФЛ
            </sch:assert>
        </sch:rule>
        <sch:rule context="em:Пред/em:СведФилиал">
            <sch:assert test="not(@СтУчНД)">
                Тег Пред/СведФилиал не должен содержать атрибут @СтУчНД
            </sch:assert>
            <sch:assert test="@ИННЮЛ">
                Тег Пред/СведФилиал должен содержать атрибут @ИННЮЛ
            </sch:assert>
            <sch:assert test="not(em:ДокПдтв)">
                Тег Пред/СведФилиал не должен содержать тег ДокПдтв
            </sch:assert>
        </sch:rule>
    </sch:pattern>

    <sch:pattern>
        <sch:title>
            Сведения о полномочиях представителя (представителей)
        </sch:title>
        <sch:rule abstract="true" id="СвПолнТип">
            <sch:let name="ТипПолн.0.Текстовое_человекочитаемое_полномочие" value="0"/>
            <sch:let name="ТипПолн.1.Машиночитаемое_полномочие" value="1"/>
            <sch:let name="ПрУтрПолн.1.Не_утрачиваются" value="1"/>
            <sch:let name="ПрУтрПолн.2.Утрачиваются" value="2"/>
            <sch:report test="@ТипПолн=$ТипПолн.0.Текстовое_человекочитаемое_полномочие and not(em:ТекстПолн)">
                При значении атрибута
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ТипПолн,
                равном '<sch:value-of select="$ТипПолн.0.Текстовое_человекочитаемое_полномочие"/>',
                должен присутствовать тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/ТекстПолн
            </sch:report>
            <sch:report test="@ТипПолн=$ТипПолн.0.Текстовое_человекочитаемое_полномочие and em:МашПолн">
                При значении атрибута
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ТипПолн,
                равном '<sch:value-of select="$ТипПолн.0.Текстовое_человекочитаемое_полномочие"/>',
                должен отсутствовать тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/МашПолн
            </sch:report>
            <sch:report test="@ТипПолн=$ТипПолн.1.Машиночитаемое_полномочие and not(em:МашПолн)">
                При значении атрибута
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ТипПолн,
                равном '<sch:value-of select="$ТипПолн.1.Машиночитаемое_полномочие"/>',
                должен присутствовать тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/МашПолн
            </sch:report>
            <sch:report test="@ТипПолн=$ТипПолн.1.Машиночитаемое_полномочие and em:ТекстПолн">
                При значении атрибута
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ТипПолн,
                равном '<sch:value-of select="$ТипПолн.1.Машиночитаемое_полномочие"/>',
                должен отсутствовать тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/ТекстПолн
            </sch:report>
            <sch:report test="@ПрУтрПолн=$ПрУтрПолн.2.Утрачиваются">
                В данный момент система не поддерживает работу с атрибутом
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ПрУтрПолн,
                равным '<sch:value-of select="$ПрУтрПолн.2.Утрачиваются"/>'
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="МашПолн">
        <sch:title>
            Сведения о машиночитаемом полномочии (машиночитаемых полномочиях)
        </sch:title>
        <sch:rule context="em:МашПолн">
            <sch:let name="codeAuth" value="@КодПолн"/>
            <sch:report test="count(../em:МашПолн)>500">
                Тег МашПолн не должен быть указан более 500 раз
            </sch:report>
            <sch:assert test="count(distinct-values(../em:МашПолн[@КодПолн=$codeAuth]/@НаимПолн))=1">
                При значении атрибута МашПолн/@КодПолн, равном '<sch:value-of select="$codeAuth"/>', значения атрибутов
                МашПолн/@НаимПолн должны совпадать
            </sch:assert>
            <sch:report test="not($ПрЭлФорм_2_ЕСИА) and @МнПолн">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен отсутствовать атрибут МашПолн/@МнПолн
            </sch:report>
            <sch:report test="count(em:ОгрСвПолн)>37">
                Тег МашПолн/ОгрСвПолн не должен быть указан более 37 раз
            </sch:report>
            <sch:report test="count(../em:МашПолн[@КодПолн=$codeAuth])>1 and not(em:ОгрСвПолн)">
                При отсутствии тега МашПолн/ОгрСвПолн, значения атрибутов МашПолн/@КодПолн не должны совпадать
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="ОгрСвПолн">
        <sch:title>
            Сведения об ограничении (ограничениях) к полномочию
        </sch:title>
        <sch:rule context="em:ОгрСвПолн">
            <sch:let name="codeRestr" value="@КодОгр"/>
            <sch:let name="codeRestrVal" value="em:КодЗначОгр"/>
            <sch:let name="textRestrValUpper" value="upper-case(em:ТексЗначОгр)"/>
            <sch:report test="em:ТексЗначОгр and @НаимЗначОгр">
                При присутствии тега ОгрСвПолн/ТексЗначОгр должен отсутствовать атрибут ОгрСвПолн/@НаимЗначОгр
            </sch:report>
            <sch:report test="em:КодЗначОгр and not(@НаимЗначОгр)">
                При присутствии тега ОгрСвПолн/КодЗначОгр должен присутствовать атрибут ОгрСвПолн/@НаимЗначОгр
            </sch:report>
            <sch:assert test="sum(../em:ОгрСвПолн/number(@ИдОгр)) = sum(1 to count(distinct-values(../em:ОгрСвПолн/@ИдОгр)))">
                Значения атрибутов ОгрСвПолн/@ИдОгр внутри одного тега МашПолн
                должны составлять неупорядоченное множество натуральных чисел (начиная с единицы, без пропусков)
            </sch:assert>
            <sch:assert test="count(distinct-values(../../em:МашПолн/em:ОгрСвПолн[@КодОгр=$codeRestr]/@НаимОгр))=1">
                При значении атрибута МашПолн/ОгрСвПолн/@КодОгр, равном '<sch:value-of select="$codeRestr"/>',
                значения атрибутов МашПолн/ОгрСвПолн/@НаимОгр должны совпадать
            </sch:assert>
            <sch:report test="count(distinct-values(../../em:МашПолн/em:ОгрСвПолн[em:КодЗначОгр=$codeRestrVal]/@НаимЗначОгр))>1">
                При значении атрибута МашПолн/ОгрСвПолн/@КодЗначОгр, равном '<sch:value-of select="$codeRestrVal"/>',
                значения атрибутов МашПолн/ОгрСвПолн/@НаимЗначОгр должны совпадать
            </sch:report>
            <sch:report test="count(../em:ОгрСвПолн[@КодОгр=$codeRestr and em:КодЗначОгр=$codeRestrVal])>1">
                При значении атрибута ОгрСвПолн/@КодОгр, равном '<sch:value-of select="$codeRestr"/>',
                значения тегов ОгрСвПолн/КодЗначОгр не должны совпадать в рамках одного тега МашПолн
            </sch:report>
            <sch:report test="count(../em:ОгрСвПолн[@КодОгр=$codeRestr and em:ТексЗначОгр and upper-case(em:ТексЗначОгр)=$textRestrValUpper])>1">
                При значении атрибута ОгрСвПолн/@КодОгр, равном '<sch:value-of select="$codeRestr"/>',
                значения тегов ОгрСвПолн/ТексЗначОгр не должны совпадать в рамках одного тега МашПолн
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="ПодпРукопис">
        <sch:title>
            Рукописная подпись
        </sch:title>
        <sch:let name="base64RegEx" value="'^([A-Za-z0-9+/]{4})+([A-Za-z0-9+/]{3}=|[A-Za-z0-9+/]{2}==)?$'"/>
        <sch:rule context="em:ПодпРукопис">
            <sch:assert test="matches(em:ХешPDFДок, $base64RegEx)">
                Тег ПодпРукопис/ХешPDFДок не соответствует формату base64
            </sch:assert>
            <sch:assert test="matches(em:ПодпИзобр, $base64RegEx)">
                Тег ПодпРукопис/ПодпИзобр не соответствует формату base64
            </sch:assert>
            <sch:assert test="matches(em:ХешПодп, $base64RegEx)">
                Тег ПодпРукопис/ХешПодп не соответствует формату base64
            </sch:assert>
        </sch:rule>
    </sch:pattern>

    <sch:pattern>
        <sch:title>
            Сведения о физическом лице
        </sch:title>
        <sch:rule abstract="true" id="СведФЛТип">
            <sch:report test="not($ПрЭлФорм_4_Налоговая) and @ПрГражд">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>', должен отсутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ПрГражд
            </sch:report>
            <sch:report test="$ПрЭлФорм_4_Налоговая and not(@ПрГражд)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ПрГражд
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="УдЛичнФЛ">
        <sch:title>
            Сведения о документе, удостоверяющем личность физического лица
        </sch:title>
        <sch:rule context="em:УдЛичнФЛ">
            <sch:let name="КодВидДок.03.Свидетельство_о_рождении" value="'03'"/>
            <sch:let name="КодВидДок.07.Военный_билет" value="'07'"/>
            <sch:let name="КодВидДок.10.Паспорт_иностранного_гражданина" value="'10'"/>
            <sch:let name="КодВидДок.11.Свидетельство_о_рассмотрении_ходатайства_о_признании_лица_беженцем" value="'11'"/>
            <sch:let name="КодВидДок.12.Вид_на_жительство_в_Российской_Федерации" value="'12'"/>
            <sch:let name="КодВидДок.13.Удостоверение_беженца" value="'13'"/>
            <sch:let name="КодВидДок.15.Разрешение_на_временное_проживание_в_Российской_Федерации" value="'15'"/>
            <sch:let name="КодВидДок.19.Свидетельство_о_предоставлении_временного_убежища" value="'19'"/>
            <sch:let name="КодВидДок.21.Паспорт_гражданина_Российской_Федерации" value="'21'"/>
            <sch:let name="КодВидДок.22.Загранпаспорт_гражданина_Российской_Федерации" value="'22'"/>
            <sch:let name="КодВидДок.24.Удостоверение_личности_военнослужащего_Российской_Федерации" value="'24'"/>
            <!--TODO: POAR-2465 Get back document type code validation for 22 value-->
            <sch:assert test="@КодВидДок=(
                    $КодВидДок.03.Свидетельство_о_рождении,
                    $КодВидДок.07.Военный_билет,
                    $КодВидДок.10.Паспорт_иностранного_гражданина,
                    $КодВидДок.11.Свидетельство_о_рассмотрении_ходатайства_о_признании_лица_беженцем,
                    $КодВидДок.12.Вид_на_жительство_в_Российской_Федерации,
                    $КодВидДок.13.Удостоверение_беженца,
                    $КодВидДок.15.Разрешение_на_временное_проживание_в_Российской_Федерации,
                    $КодВидДок.19.Свидетельство_о_предоставлении_временного_убежища,
                    $КодВидДок.21.Паспорт_гражданина_Российской_Федерации,
                    $КодВидДок.24.Удостоверение_личности_военнослужащего_Российской_Федерации
                    )">
                В данный момент система не поддерживает работу с атрибутом
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@КодВидДок,
                равным '<sch:value-of select="@КодВидДок"/>'
            </sch:assert>
            <sch:report test="@КодВидДок!=$КодВидДок.10.Паспорт_иностранного_гражданина and not(@ВыдДок)">
                При значении атрибута
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@КодВидДок,
                равном '<sch:value-of select="@КодВидДок"/>', должен присутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ВыдДок
            </sch:report>
            <sch:report test="@КодВидДок!=$КодВидДок.10.Паспорт_иностранного_гражданина and not(@КодВыдДок)">
                При значении атрибута
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@КодВидДок,
                равном '<sch:value-of select="@КодВидДок"/>', должен присутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@КодВыдДок
            </sch:report>
            <sch:report test="@КодВидДок!=$КодВидДок.22.Загранпаспорт_гражданина_Российской_Федерации and em:expDate">
                При значении атрибута
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@КодВидДок,
                равном '<sch:value-of select="@КодВидДок"/>', должен отсутствовать тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/expDate
            </sch:report>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="ДокПдтв">
        <sch:title>
            Документ, подтверждающий полномочия лица, действующего без доверенности
        </sch:title>
        <sch:rule context="em:ДокПдтв">
            <sch:extends rule="ДокПдтвТип"/>
        </sch:rule>
    </sch:pattern>

    <sch:pattern>
        <sch:title>
            Документ, подтверждающий полномочия лица, действующего без доверенности
        </sch:title>
        <sch:rule abstract="true" id="ДокПдтвТип">
            <sch:assert test="@НаимДокПдтв">
                Тег <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>
                должен содержать атрибут @НаимДокПдтв
            </sch:assert>
            <sch:assert test="@ДатаВыд">
                Тег <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>
                должен содержать атрибут @ДатаВыд
            </sch:assert>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="АдрРег">
        <sch:title>
            Адрес юридического лица / филиала (обособленного подразделения) юридического лица в Российской Федерации
        </sch:title>
        <sch:rule context="em:АдрРег">
            <sch:extends rule="АдрТип"/>
        </sch:rule>
    </sch:pattern>

    <sch:pattern id="АдрМЖ">
        <sch:title>
            Адрес места жительства
        </sch:title>
        <sch:rule context="em:АдрМЖ">
            <sch:extends rule="АдрТип"/>
        </sch:rule>
    </sch:pattern>

    <sch:pattern>
        <sch:title>
            Сведения об адресе
        </sch:title>
        <sch:rule abstract="true" id="АдрТип">
            <sch:report test="$ПрЭлФорм_3_Нотариус and not(em:АдрРФ or em:ФИАСАдрРФ)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>', должен присутствовать тег
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/АдрРФ или
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/ФИАСАдрРФ
            </sch:report>
            <sch:report test="em:ФИАСАдрРФ and not(@ИдФИАС)">
                При присутствии тега
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/ФИАСАдрРФ
                должен присутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ИдФИАС
            </sch:report>
            <sch:report test="not(em:ФИАСАдрРФ) and @ИдФИАС">
                При отсутствии тега
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/ФИАСАдрРФ
                должен отсутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ИдФИАС
            </sch:report>
            <sch:report test="$ПрЭлФорм_4_Налоговая and not(em:АдрРФ or em:ФИАСАдрРФ)">
                При значении атрибута Доверенность/@ПрЭлФорм,
                равном '<sch:value-of select="/em:Доверенность/@ПрЭлФорм"/>',
                должен присутствовать атрибут
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@АдрРФ или
                <sch:value-of select="../local-name()"/>/<sch:value-of select="local-name()"/>/@ФИАСАдрРФ

            </sch:report>
        </sch:rule>
    </sch:pattern>
</sch:schema>
