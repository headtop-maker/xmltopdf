																<xs:documentation>Дата составления договорного документа</xs:documentation>
															</xs:annotation>
														</xs:element>
														<xs:element name="БезДаты">
															<xs:annotation>
																<xs:documentation>Без даты</xs:documentation>
															</xs:annotation>
															<xs:simpleType>
																<xs:restriction base="xs:string">
																	<xs:length value="8"/>
